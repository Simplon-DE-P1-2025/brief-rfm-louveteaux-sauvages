# Configuration compose local (dev)
ENV_FILE_PATH=.env.dev
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.0
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Base Airflow metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PUBLIC_PORT=5432

# Base applicative RFM
APP_DB_USER=rfm
APP_DB_PASSWORD=rfm
APP_DB_NAME=rfm
APP_DB_PUBLIC_PORT=5433

# Airflow web/API
AIRFLOW_API_PUBLIC_PORT=8080
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret_dev
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Streamlit local
STREAMLIT_PUBLIC_PORT=8501

# Cle fernet pour dev uniquement (placeholder)
FERNET_KEY=change_me_fernet_key

# Optionnel: requirements additionnels au runtime Airflow
_PIP_ADDITIONAL_REQUIREMENTS=openpyxl
